# Preferred database config
# DSN="postgres://[username]:[password]@[host]:5432/[dbname]"

# MySQL examples
# DSN="mysql://[username]:[password]@[host]:3306/[dbname]?charset=utf8mb4"
# DSN="[username]:[password]@tcp([host]:3306)/[dbname]?charset=utf8mb4&parseTime=true"

# SQLite examples
# DSN="sqlite://./tmp/airway.db"
# DSN="sqlite://:memory:"

# Redis
# REDIS="redis://[username]:[password]@[host]:6379/0"

# Listen port (backend API server)
PORT="1905"

# Optional sub-path prefix when deployed behind a proxy, e.g. http://host/airway/...
# URL_PREFIX="/airway"

# File storage
# Driver: local | s3 | r2 | cos
STORAGE_DRIVER="local"

# Local storage root dir (driver=local)
STORAGE_ROOT="./data/storage"

# Cloud object storage
# Amazon S3:     STORAGE_DRIVER="s3" STORAGE_REGION="us-east-1"
# Tencent COS:   STORAGE_DRIVER="cos" STORAGE_REGION="ap-guangzhou"
# Cloudflare R2: STORAGE_DRIVER="r2" STORAGE_ENDPOINT="<account_id>.r2.cloudflarestorage.com"
# STORAGE_REGION=""
# STORAGE_ENDPOINT=""   # optional endpoint override; required for r2
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# Public base URL (e.g. CDN). When set, file URLs are built from it instead of presigned URLs
# STORAGE_PUBLIC_URL=""

# ---------------------------------------------------------------------------
# IM: identity
# ---------------------------------------------------------------------------
# The plugin ships no login flow of its own: host applications sign their
# users' (name, uuid) pair into an HMAC credential, and the plugin verifies
# it statelessly, auto-registering the user on first sight.
# See docs/design/identity.md for the credential format and integration guide.
# Required for both host-side signing and POST /internal/v1/credentials.
# IM_AUTH_SECRET="change-me"
# Previous secret, accepted during zero-downtime rotation (optional):
# IM_AUTH_SECRET_PREVIOUS=""

# ---------------------------------------------------------------------------
# IM: admin API (/admin/api)
# ---------------------------------------------------------------------------
# IM_ADMIN_USERNAME="admin"
# IM_ADMIN_PASSWORD="change-me"
# Gateway base URL used by admin status (online users) and credential
# revocation (kicking live connections). Default: http://127.0.0.1:1910
# IM_GATEWAY_URL="http://127.0.0.1:1910"

# ---------------------------------------------------------------------------
# IM: service-to-service secret (backend <-> gateway <-> delivery)
# ---------------------------------------------------------------------------
# Required for the internal /internal/v1 API and the gateway delivery endpoint.
# IM_INTERNAL_SECRET="change-me"
# Address of the backend's internal API listener (server-to-server only;
# never expose to the public network). Default: 127.0.0.1:1906
# IM_INTERNAL_ADDR="127.0.0.1:1906"

# ---------------------------------------------------------------------------
# IM: gateway service (./deps/gateway)
# ---------------------------------------------------------------------------
# GATEWAY_ADDR=":1910"
# BACKEND_URL="http://127.0.0.1:1906"   # the backend's internal API listener
# GATEWAY_ALLOWED_ORIGINS=""   # comma-separated Origin allowlist for browsers

# ---------------------------------------------------------------------------
# IM: delivery service (./deps/delivery)
# ---------------------------------------------------------------------------
# DELIVERY_ADDR=":1920"
# GATEWAY_URL="http://127.0.0.1:1910"
# DELIVERY_POLL_INTERVAL_MS="500"

# Timezone
TZ="Asia/Shanghai"
